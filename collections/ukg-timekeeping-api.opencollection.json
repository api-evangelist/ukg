{
  "opencollection": "1.0.0",
  "info": {
    "name": "UKG Pro HCM Accruals Timekeeping API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Timekeeping",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "UKG Pro WFM Get Employee Timecards",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://service.ultipro.com/v1/employees/:employeeId/timecards",
            "params": [
              {
                "name": "employeeId",
                "value": "EMP001",
                "type": "path",
                "description": "Employee identifier"
              },
              {
                "name": "startDate",
                "value": "2026-01-01",
                "type": "query",
                "description": "Start date for timecard retrieval"
              },
              {
                "name": "endDate",
                "value": "2026-01-14",
                "type": "query",
                "description": "End date for timecard retrieval"
              }
            ]
          },
          "docs": "Retrieve timecard records for an employee within a date range."
        },
        {
          "info": {
            "name": "UKG Pro WFM Get Employee Punches",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://service.ultipro.com/v1/employees/:employeeId/punches",
            "params": [
              {
                "name": "employeeId",
                "value": "EMP001",
                "type": "path",
                "description": "Employee identifier"
              },
              {
                "name": "startDate",
                "value": "2026-01-01",
                "type": "query",
                "description": "Start date for punch retrieval"
              },
              {
                "name": "endDate",
                "value": "2026-01-14",
                "type": "query",
                "description": "End date for punch retrieval"
              }
            ]
          },
          "docs": "Retrieve clock punch records for an employee."
        },
        {
          "info": {
            "name": "UKG Pro WFM Create Punch",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://service.ultipro.com/v1/employees/:employeeId/punches",
            "params": [
              {
                "name": "employeeId",
                "value": "EMP001",
                "type": "path",
                "description": "Employee identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit a clock punch for an employee (in, out, or transfer)."
        }
      ]
    }
  ],
  "bundled": true
}