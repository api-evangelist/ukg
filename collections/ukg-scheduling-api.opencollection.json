{
  "opencollection": "1.0.0",
  "info": {
    "name": "UKG Pro HCM Accruals Scheduling API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Scheduling",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "UKG Pro WFM List Schedules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://service.ultipro.com/v1/schedules",
            "params": [
              {
                "name": "locationId",
                "value": "LOC-NYC",
                "type": "query",
                "description": "Location to retrieve schedules for"
              },
              {
                "name": "startDate",
                "value": "2026-01-01",
                "type": "query",
                "description": "Start date for schedule retrieval"
              },
              {
                "name": "endDate",
                "value": "2026-01-07",
                "type": "query",
                "description": "End date for schedule retrieval"
              }
            ]
          },
          "docs": "Retrieve employee schedules for a location and date range."
        },
        {
          "info": {
            "name": "UKG Pro WFM Get Employee Shifts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://service.ultipro.com/v1/employees/:employeeId/shifts",
            "params": [
              {
                "name": "employeeId",
                "value": "EMP001",
                "type": "path",
                "description": "Employee identifier"
              },
              {
                "name": "startDate",
                "value": "2026-01-01",
                "type": "query",
                "description": "Start date"
              },
              {
                "name": "endDate",
                "value": "2026-01-14",
                "type": "query",
                "description": "End date"
              }
            ]
          },
          "docs": "Retrieve scheduled shifts for a specific employee."
        }
      ]
    }
  ],
  "bundled": true
}